# Boomerang RP integration (IzzyXO/TitanBot)
# Use a random secret of at least 32 characters and keep it private.
RP_BRIDGE_SECRET=
# Discord text channel ID where FiveM events should be logged.
RP_LOG_CHANNEL_ID=
# Optional guild ID allowlist is enforced by the resource payload; set in FiveM server.cfg.

# Required allowlist: only events for this Discord server are accepted.
RP_GUILD_ID=
